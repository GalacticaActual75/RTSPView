<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.46-beta.5</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Product>RTSPView</Product>
    <Title>RTSPView</Title>
    <AssemblyTitle>RTSPView</AssemblyTitle>
    <Company>RTSPView</Company>
    <Description>RTSPView camera wall</Description>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
</Project>
