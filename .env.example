# Reference only; set variables in the Windows user environment. No .env loader is used.
# Optional; blank uses RTSPView app data, or existing SpotMonitor data on upgrade.
RTSPVIEW_DATA_DIR=
# Public GitHub repository. No access key/token is needed or supported.
RTSPVIEW_GITHUB_REPOSITORY=GalacticaActual75/RTSPView
ASPNETCORE_URLS=http://127.0.0.1:5080
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=localhost;127.0.0.1;[::1]
