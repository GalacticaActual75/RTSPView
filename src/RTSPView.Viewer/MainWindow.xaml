<Window x:Class="RTSPView.Viewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RTSPView.Viewer" Title="RTSPView — Stream Wall" Icon="Assets/RTSPView.ico" Width="1600" Height="950" MinWidth="900" MinHeight="600" Background="#050505" Foreground="White" WindowStartupLocation="Manual" MouseMove="Window_MouseMove">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid x:Name="WallViewport" Background="Black">
    <Grid x:Name="WallGrid" Background="Black" UseLayoutRounding="True" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center">
    </Grid>
    </Grid>
    <local:WallDiagnosticsPanel x:Name="DiagnosticsPanel" Grid.Column="1"/>
    </Grid>
    <Border x:Name="ControlBar" Grid.Row="1" Background="{StaticResource ProductBackground}" BorderBrush="{StaticResource ProductLine}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <Button x:Name="FullExitButton" DockPanel.Dock="Right" Style="{StaticResource ProductButton}" Content="Full exit" Width="100" Height="32" Margin="16,0,0,4" VerticalAlignment="Bottom" Click="FullExitButton_Click" ToolTip="Close the viewer and pause automatic recovery. Web administration stays online."/>
      <WrapPanel VerticalAlignment="Center" ItemHeight="40">
        <TextBlock VerticalAlignment="Center" Text="Stream" Margin="0,0,8,0"/>
        <ComboBox x:Name="SlotBox" Width="65" Height="32" SelectedIndex="0" SelectionChanged="SlotBox_SelectionChanged"></ComboBox>
        <Button Style="{StaticResource ProductButton}" Width="120" Height="32" Margin="8,0,0,0" Content="Restart stream" Click="RestartButton_Click" Background="#343A40" Foreground="White" BorderThickness="0"/>
        <Button Style="{StaticResource ProductButton}" Width="105" Height="32" Margin="8,0,0,0" Content="Full Screen" Click="FullScreenButton_Click" Background="#343A40" Foreground="White" BorderThickness="0"/>
        <Button Style="{StaticResource ProductButton}" x:Name="DiagnosticsButton" Width="120" Height="32" Margin="8,0,0,0" Content="Diagnostics" Click="DiagnosticsButton_Click" ToolTip="Open or close camera diagnostics" Background="#343A40" Foreground="White" BorderThickness="0"/>
        <Button Style="{StaticResource ProductButton}" Width="105" Height="32" Margin="8,0,0,0" Content="Streams…" Click="ConfigureButton_Click" Background="#343A40" Foreground="White" BorderThickness="0"/>
        <Button Style="{StaticResource ProductButton}" Width="130" Height="32" Margin="8,0,0,0" Content="Open settings" Click="OpenWebConfig_Click" ToolTip="Open local web configuration in your default browser" Background="#343A40" Foreground="White" BorderThickness="0"/>
        <TextBlock x:Name="LanAddressText" MaxWidth="240" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#B8C1CC" FontSize="12" Text="LAN IP: detecting…" TextTrimming="CharacterEllipsis"/>
      </WrapPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
