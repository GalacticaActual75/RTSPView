<Window x:Class="RTSPView.Viewer.SplashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="560" Height="310" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#080A0D" Foreground="White" ShowInTaskbar="True" Topmost="True">
  <Border BorderBrush="#252A31" BorderThickness="1" CornerRadius="8" Background="#101318">
    <Grid Margin="42">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="RTSPView" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="R T S P   C A M E R A   W A L L" FontSize="11" Foreground="#7FA9D8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
      <ProgressBar x:Name="LoadingBar" Grid.Row="1" Height="3" IsIndeterminate="True" Foreground="#2684E5" Background="#222830" BorderThickness="0"/>
      <TextBlock x:Name="StatusText" Grid.Row="2" Text="Starting…" Foreground="#AEB8C4" FontSize="13" HorizontalAlignment="Center" Margin="0,18,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
  </Border>
</Window>
