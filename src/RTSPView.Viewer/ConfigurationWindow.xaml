<Window x:Class="RTSPView.Viewer.ConfigurationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RTSPView — Streams" Icon="Assets/RTSPView.ico" Width="840" Height="700" MinWidth="700" MinHeight="550" WindowStartupLocation="CenterOwner" Background="{StaticResource ProductBackground}" Foreground="{StaticResource ProductText}" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource ProductButton}"/><Style TargetType="TextBox" BasedOn="{StaticResource ProductInput}"/><Style TargetType="CheckBox" BasedOn="{StaticResource ProductCheck}"/><Style TargetType="Expander" BasedOn="{StaticResource ProductExpander}"/></Window.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Streams" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,24"/>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="SlotBox" SelectionChanged="SlotBox_SelectionChanged" Background="Transparent" Foreground="{StaticResource ProductText}" BorderThickness="0" Margin="0,0,24,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Select stream"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,12">
        <CheckBox x:Name="EnabledBox" Content="Enable stream"/>
        <TextBlock Text="Name" Foreground="{StaticResource ProductMuted}"/><TextBox x:Name="NameBox" AutomationProperties.Name="Stream name"/>
        <TextBlock Text="Source URL" Foreground="{StaticResource ProductMuted}"/><TextBox x:Name="UrlBox" AutomationProperties.Name="Source URL" ToolTip="RTSP, HTTP/HLS/DASH or a supported website URL."/>
        <TextBlock Text="Source type"/><ComboBox x:Name="SourceModeBox" Height="34" Margin="0,6,0,16" AutomationProperties.Name="Source type"><ComboBoxItem>Auto</ComboBoxItem><ComboBoxItem>Direct stream</ComboBoxItem><ComboBoxItem>Streamlink</ComboBoxItem><ComboBoxItem>yt-dlp</ComboBoxItem></ComboBox>
        <TextBlock Text="Website quality limit"/><ComboBox x:Name="QualityBox" Height="34" Margin="0,6,0,16" AutomationProperties.Name="Website quality limit"><ComboBoxItem>360p</ComboBoxItem><ComboBoxItem>480p</ComboBoxItem><ComboBoxItem>720p</ComboBoxItem><ComboBoxItem>1080p</ComboBoxItem><ComboBoxItem>1440p</ComboBoxItem><ComboBoxItem>2160p</ComboBoxItem><ComboBoxItem>Best available</ComboBoxItem></ComboBox>
        <Expander Header="Advanced streaming"><StackPanel Margin="0,16,0,0"><TextBlock Text="Transport"/><ComboBox x:Name="TransportBox" SelectedIndex="0" Height="34" Margin="0,6,0,16" AutomationProperties.Name="Transport"><ComboBoxItem>Auto</ComboBoxItem><ComboBoxItem>TCP</ComboBoxItem><ComboBoxItem>UDP</ComboBoxItem></ComboBox><TextBlock Text="Network cache (ms)"/><TextBox x:Name="CacheBox" AutomationProperties.Name="Network cache in milliseconds"/><CheckBox x:Name="CompositeBox" Content="Composite stream compatibility" ToolTip="Uses TCP and 3000 ms cache."/><CheckBox x:Name="LowLatencyBox" Content="Low latency"/><CheckBox x:Name="AudioBox" Content="Decode audio"/></StackPanel></Expander>
        <Expander Header="Advanced recovery"><StackPanel Margin="0,16,0,0"><TextBlock Text="Startup timeout (seconds)"/><TextBox x:Name="StartupBox" AutomationProperties.Name="Startup timeout"/><TextBlock Text="Stall timeout (seconds)"/><TextBox x:Name="WatchdogBox" AutomationProperties.Name="Stall timeout"/><TextBlock Text="Maximum retry delay (seconds)"/><TextBox x:Name="BackoffBox" AutomationProperties.Name="Maximum retry delay"/></StackPanel></Expander>
        <Expander Header="Backup and restore"><StackPanel Margin="0,16,0,0"><TextBlock Text="Export omits stream credentials. Import replaces the saved configuration." TextWrapping="Wrap" Foreground="{StaticResource ProductMuted}" Margin="0,0,0,12"/><WrapPanel><Button Content="Import…" Click="ImportButton_Click" Margin="0,0,8,0"/><Button Content="Export…" Click="ExportButton_Click"/></WrapPanel></StackPanel></Expander>
      </StackPanel></ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource ProductLine}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0"><DockPanel><TextBlock Text="Saves stream changes across layouts." Foreground="{StaticResource ProductMuted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0"/><Button Content="Save &amp; apply" Click="SaveButton_Click" Background="{StaticResource ProductAccent}"/></StackPanel></DockPanel></Border>
  </Grid>
</Window>
