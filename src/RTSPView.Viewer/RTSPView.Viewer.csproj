<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Retained only for installed updater compatibility; all visible product metadata is RTSPView. -->
    <AssemblyName>SpotMonitor.Viewer</AssemblyName>
    <RootNamespace>RTSPView.Viewer</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\RTSPView.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\RTSPView.ico" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23" />
    <ProjectReference Include="..\RTSPView.Core\RTSPView.Core.csproj" />
    <ProjectReference Include="..\RTSPView.Infrastructure\RTSPView.Infrastructure.csproj" />
  </ItemGroup>
</Project>
