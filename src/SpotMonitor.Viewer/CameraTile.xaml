<UserControl x:Class="SpotMonitor.Viewer.CameraTile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Background="Black">
  <Border Background="Black" BorderBrush="#24272B" BorderThickness="1">
    <vlc:VideoView x:Name="VideoView" Background="Black">
      <Grid Background="#01000000">
        <Border x:Name="OverlayPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" CornerRadius="3" Background="#B0101010">
          <StackPanel>
            <TextBlock x:Name="NameText" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="DetailsText" Foreground="#B8C1CC" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="StateText" Text="Disabled" Foreground="#AAB2BD" FontSize="16" HorizontalAlignment="Center"/>
          <TextBlock x:Name="SlotText" Foreground="#59616B" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </vlc:VideoView>
  </Border>
</UserControl>
