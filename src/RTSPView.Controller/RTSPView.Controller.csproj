<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Retained only for installed updater compatibility; all visible product metadata is RTSPView. -->
    <AssemblyName>SpotMonitor.Controller</AssemblyName>
    <RootNamespace>RTSPView.Controller</RootNamespace><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><RuntimeIdentifier>win-x64</RuntimeIdentifier><ApplicationIcon>Assets\RTSPView.Controller.ico</ApplicationIcon></PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\artifacts\stream-resolver\stream-resolver\**\*" Link="Streaming\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\artifacts\tapo-reader\tapo-reader\**\*" Link="Tapo\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <Content Include="ThirdParty\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\RTSPView.Hardware\RTSPView.Hardware.csproj" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <ProjectReference Include="..\RTSPView.Core\RTSPView.Core.csproj"/>
    <ProjectReference Include="..\RTSPView.Infrastructure\RTSPView.Infrastructure.csproj"/>
  </ItemGroup>
</Project>
